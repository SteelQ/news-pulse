# Docker Compose 环境变量配置示例
# 复制此文件为 .env 并根据需要修改

# Web 访问端口（Nginx 对外暴露）
WEB_PORT=8080
# 前端开发端口（Vite）
VITE_PORT=5173
# 前端 API 地址（需与 WEB_PORT 保持一致）
VITE_API_BASE_URL=http://localhost:8080/api

# 数据库端口（宿主机映射）
DB_PORT=33060
# 数据库初始化账号
DB_DATABASE=news_pulse
DB_USERNAME=news_pulse
DB_PASSWORD=password
# root 密码（仅用于初始化/管理）
DB_ROOT_PASSWORD=rootpassword